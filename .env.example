# Dashboard access (use long random values in production)
PUBLISHER_PASSWORD=
SESSION_SECRET=

# GitHub token needs Contents: Read and write on the portfolio repository
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BRANCH=

# Public portfolio URL used in the LinkedIn post link
PORTFOLIO_URL=https://your-domain.com

# LinkedIn Developer app with "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://publisher.your-domain.com/api/linkedin/callback
